# .env.local 로 복사해서 값을 채우세요.
# Vercel에 Supabase 연동(vercel integration add supabase)을 하면 자동으로 들어가고,
# `vercel env pull .env.local` 로 받아올 수 있어요.

# Supabase 프로젝트 > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 서버 전용 (학생 API · 데이터 이전 스크립트). 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SECRET_KEY=sb_secret_xxx

# 문제 출제 챗봇 · 문항 분석 (기존: 설정 화면에서 입력하던 키)
OPENAI_API_KEY=

# 기본 문항 세트를 내보낼 기준 교사 계정 (npm run sample:update)
SAMPLE_EMAIL=
