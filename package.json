{
  "name": "class-tool-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:sheet": "node --env-file-if-exists=.env.local scripts/import-sheet.mjs",
    "db:push": "supabase db push",
    "typecheck": "tsc --noEmit",
    "db:types": "bash -c \"set -a; source .env.local; supabase gen types typescript --db-url \\\"$POSTGRES_URL_NON_POOLING\\\" --schema public > src/lib/database.types.ts\"",
    "smoke:teacher": "node --env-file=.env.local --env-file-if-exists=.env.development.local scripts/smoke-teacher-api.mjs",
    "smoke:live": "node --env-file=.env.local --env-file-if-exists=.env.development.local scripts/smoke-live.mjs",
    "parity:analysis": "node --env-file=.env.local --env-file-if-exists=.env.development.local scripts/parity-analysis.mjs",
    "smoke:ai-mock": "node --env-file=.env.local --env-file-if-exists=.env.development.local scripts/smoke-ai-mock.mjs",
    "i18n:student": "node --env-file-if-exists=.env.local scripts/i18n-student.mjs",
    "sample:export": "node --env-file=.env.local scripts/sample-export.mjs",
    "sample:build": "node scripts/sample-build.mjs",
    "sample:update": "npm run sample:export && npm run sample:build",
    "local:up": "node scripts/local.mjs up",
    "local:demo": "node scripts/local.mjs demo",
    "local:reset": "node scripts/local.mjs reset",
    "local:down": "node scripts/local.mjs down"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "exceljs": "^4.4.0",
    "supabase": "^3.0.0",
    "typescript": "^5"
  }
}
